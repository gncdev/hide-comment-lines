<idea-plugin url="https://github.com/gncdev/hide-comment-lines">
  <id>dev.hidecommentlines</id>
  <name>Hide Comment Lines</name>
  <version>1.0.2</version>
  <vendor url="https://github.com/gncdev">gncdev</vendor>
  <description>Hide comment-only lines while reading code. The comments stay in the source file, and inline comments stay visible. Use View → Hide Comment Lines to switch between views. Each project remembers your choice.</description>
  <idea-version since-build="252" until-build="263.*"/>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <editorFactoryListener implementation="dev.hidecommentlines.CommentEditorListener"/>
  </extensions>
  <applicationListeners>
    <listener class="dev.hidecommentlines.CommentEditorListener"
              topic="com.intellij.ide.plugins.DynamicPluginListener"/>
  </applicationListeners>
  <actions>
    <action id="HideCommentLines.Toggle" class="dev.hidecommentlines.ToggleComments"
            text="Hide Comment Lines" description="Toggle comment-only lines in this project">
      <add-to-group group-id="ViewMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
